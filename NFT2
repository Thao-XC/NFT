  document.getElementById('question').placeholder = t.qPlaceholder;
  document.getElementById('queLabel').textContent = t.queLabel;
  document.getElementById('haoFieldLabel').textContent = t.haoFieldLabel;
  document.getElementById('castBtn').textContent = t.castBtn;
  document.getElementById('loading').textContent = t.loading;
  document.getElementById('judgmentLabel').textContent = t.judgmentLabel;
  document.getElementById('footerText').innerHTML = t.footer;
  document.querySelectorAll('.classical-toggle').forEach(btn => {
    const box = btn.nextElementSibling;
    btn.textContent = box.classList.contains('show') ? t.hideClassical : t.showClassical;
  });
  document.getElementById('langEnBtn').classList.toggle('active', currentLang === 'en');
  document.getElementById('langJaBtn').classList.toggle('active', currentLang === 'ja');

  if(lastReading) renderResult(lastReading);
}

function setLang(lang){
  currentLang = lang;
  applyLanguage();
}

function step(id, delta){
  const el = document.getElementById(id);
  const max = id === 'que' ? 64 : 6;
  let v = parseInt(el.value || '1', 10) + delta;
  if(v < 1) v = 1;
  if(v > max) v = max;
  el.value = v;
}
function randomize(id, max){
  document.getElementById(id).value = Math.floor(Math.random()*max)+1;
}

function modernize(text){
  let result = text;
  for(const [oldPhrase, newPhrase] of DATA.GLOSSARY){
    const re = new RegExp(oldPhrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'ig');
    result = result.replace(re, newPhrase);
  }
  return result;
}

function detectTheme(question){
  const lowered = question.toLowerCase();
  const words = lowered.split(/\s+/);
  for(const key in DATA.THEMES){
    const t = DATA.THEMES[key];
    for(const kw of t.keywords){
      if(kw.includes(' ')){
        if(lowered.includes(kw)) return t;
      } else if(words.includes(kw)){
        return t;
      }
    }
  }
  return {topic:'your question', good:'the signs point toward moving forward', bad:'the signs point toward waiting'};
}


// Figures out what KIND of question this is, since "why", "when", and
// "how" questions can't honestly be answered with a plain yes/no.
function detectQuestionType(question){
  const q = question.trim().toLowerCase();
  if(/^when\b/.test(q)) return 'when';
  if(/^why\b/.test(q)) return 'why';
  if(/^how\b/.test(q)) return 'how';
  if(/^(will|is|are|does|do|did|was|were|can|should|shall)\b/.test(q)) return 'yesno';
  return 'other';
}

// Weighted scoring: raw word-counting over-favored "favorable" because
// classical phrasing like "furthers"/"further" appears constantly as
// SENTENCE STRUCTURE, not as an actual signal of good or bad fortune.
// This version weighs specific phrases, handles a few negations, and
// treats filler phrases like "no blame" as neutral rather than positive.
const SCORE_OVERRIDES = [
  ["supreme good fortune", 3], ["great good fortune", 3],
  ["remorse disappears", 1], ["no cause for remorse", 1],
  ["does not further", -2], ["not favorable", -2],
];
const SCORE_BASE = [
  ["good fortune", 2], ["success", 2], ["favorable", 1], ["no blame", 0],
  ["misfortune", -2], ["danger", -1], ["humiliation", -2], ["regret", -1],
  ["remorse", -1], ["disgrace", -2], ["obstruction", -1], ["loss", -1],
  ["oppression", -1], ["difficult", -1], ["trouble", -1], ["stuck", -1],
  ["grief", -1], ["misery", -1], ["shame", -2], ["carelessness", -1],
];

function weightedScore(text){
  let t = text.toLowerCase();
  let total = 0;
  for(const [phrase, w] of SCORE_OVERRIDES){
    total += (t.split(phrase).length - 1) * w;
    t = t.split(phrase).join('');
  }
  for(const [phrase, w] of SCORE_BASE){
    total += (t.split(phrase).length - 1) * w;
  }
  return total;
}

// The Hao (your specific line) is the actual answer to your specific
// position - it should dominate the verdict. The Judgment is only the
// hexagram's general theme and is shared across all 6 Hao, so weighting
// it equally let a positive Judgment cancel out a genuinely negative
// line (e.g. Judgment says "good fortune" but Hao 3 says "Misfortune").
// Line counts 2x, Judgment counts 1x, so the specific line wins ties.
function scoreFortune(judgment, line){
  return weightedScore(line) * 3 + weightedScore(judgment);
  // >=1 favorable, <=-1 cautionary, 0 genuinely mixed
}

function toggleClassical(btn){
  const box = btn.nextElementSibling;
  box.classList.toggle('show');
  const t = UI[currentLang];
  btn.textContent = box.classList.contains('show') ? t.hideClassical : t.showClassical;
}

function buildHexlines(que, hao){
  const wrap = document.getElementById('hexlines');
  wrap.innerHTML = '';
  // Stylized line pattern seeded from que number (not the authentic binary
  // encoding - a real King Wen lookup table would be needed for that).
  let seed = que * 2654435761 % 2**32;
  for(let i=1; i<=6; i++){
    seed = (seed * 1103515245 + 12345) % 2**31;
    const solid = (seed % 2 === 0);
    const div = document.createElement('div');
    div.className = 'hexline ' + (solid ? 'solid' : 'broken') + (i === hao ? ' active' : '');
    if(solid){
      div.innerHTML = '<div class="bar"></div>';
    } else {
      div.innerHTML = '<div class="bar bar1"></div><div class="bar bar2"></div>';
    }
    wrap.appendChild(div);
  }
}

// Builds the language-independent parts of a reading (theme match, question
// type, and fortune score) ONCE, so switching language later doesn't need
// to recompute anything - just re-render the text in the new language.
function computeReading(que, hao, question){
  const hex = DATA.OFFLINE_DATA[String(que)];
  const judgment = hex.wilhelm_judgment.text;
  const line = hex.wilhelm_lines[String(hao)].text;
  const score = question ? scoreFortune(judgment, line) : null;
  const themeKey = question ? detectThemeKey(question) : null;
  const qType = question ? detectQuestionType(question) : null;
  return {que, hao, question, hex, judgment, line, score, themeKey, qType};
}

// Returns just the KEY ("career","love",...) so we can look up EN or JA
// advice text for it later, independent of which language matched it.
function detectThemeKey(question){
  const lowered = question.toLowerCase();
  const words = lowered.split(/\s+/);
  for(const key in DATA.THEMES){
    const t = DATA.THEMES[key];
    for(const kw of t.keywords){
      if(kw.includes(' ')){
        if(lowered.includes(kw)) return key;
      } else if(words.includes(kw)){
        return key;
      }
    }
  }
  return null;
}

function renderResult(reading){
  const t = UI[currentLang];
  const {que, hao, question, hex, judgment, line, score, themeKey, qType} = reading;

  document.getElementById('queTitle').textContent = 'Que ' + que + ': ' + hex.english;
  document.getElementById('queSub').textContent = question ? '\u201c' + question + '\u201d' : t.noQuestion;
  document.getElementById('haoLabel').textContent = t.haoLabelPrefix + ' ' + hao + ' ' + t.haoLabelSuffix;

  const enNoteVisible = currentLang === 'ja';
  document.getElementById('judgmentEnNote').style.display = enNoteVisible ? 'block' : 'none';
  document.getElementById('judgmentEnNote').textContent = t.enNote;
  document.getElementById('lineEnNote').style.display = enNoteVisible ? 'block' : 'none';
  document.getElementById('lineEnNote').textContent = t.enNote;

  document.getElementById('judgmentPlain').textContent = modernize(judgment);
  document.getElementById('judgmentClassical').textContent = judgment;
  document.getElementById('lineClassical').textContent = line;
  document.getElementById('linePlain').textContent = modernize(line);

  document.querySelectorAll('.classical-text').forEach(el => el.classList.remove('show'));
  document.querySelectorAll('.classical-toggle').forEach(el => el.textContent = t.showClassical);

  buildHexlines(que, hao);

  const stamp = document.getElementById('stamp');
  const bottomLine = document.getElementById('bottomLine');
  stamp.classList.remove('mixed');
  stamp.style.animation = 'none'; stamp.offsetHeight; stamp.style.animation = null;

  if(question){
    const favorable = score >= 1;
    const mixed = score > -1 && score < 1;
    const theme = currentLang === 'ja'
      ? (THEME_ADVICE_JA[themeKey] || THEME_ADVICE_JA.default)
      : (DATA.THEMES[themeKey] || {topic:'your question', good:'the signs point toward moving forward', bad:'the signs point toward waiting'});

    let headline, advice;
    const L = currentLang === 'ja' ? {
      soon:'\u8fd1\u3044\u3046\u3061', notYet:'\u307e\u3060\u65e9\u3044', unclear:'\u4e0d\u660e',
      reflect:'\u5185\u7701', directly:'\u76f4\u63a5\u7684\u306b', carefully:'\u6ce8\u610f\u6df1\u304f',
      eitherWay:'\u3069\u3061\u3089\u3067\u3082', yes:'\u306f\u3044', no:'\u3044\u3044\u3048',
      whenMixed:"\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u306f\u3063\u304d\u308a\u3057\u307e\u305b\u3093\u3002\u6570\u65e5\u5f8c\u306b\u3082\u3046\u4e00\u5ea6\u8003\u3048\u3066\u307f\u3066\u304f\u3060\u3055\u3044",
      whenGood:"\u65e9\u3081\u306b\u52d5\u304f\u65b9\u304c\u826f\u3055\u305d\u3046\u3067\u3059",
      whenBad:"\u3082\u3046\u5c11\u3057\u6642\u9593\u3092\u304a\u3044\u305f\u65b9\u304c\u826f\u3044\u3067\u3057\u3087\u3046",
      whyMixed:"\u8aad\u307f\u306f\u6df7\u5728\u3057\u3066\u3044\u307e\u3059\u3002\u7406\u7531\u306f\u4e00\u3064\u3067\u306f\u306a\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093",
      whyGood:"\u4eca\u3042\u306a\u305f\u306b\u6709\u5229\u306b\u50cd\u3044\u3066\u3044\u308b\u4f55\u304b\u304c\u7406\u7531\u306e\u3088\u3046\u3067\u3059",
      whyBad:"\u30d0\u30e9\u30f3\u30b9\u304c\u5d29\u308c\u3066\u3044\u305f\u308a\u3001\u6025\u304e\u3059\u304e\u3066\u3044\u308b\u3053\u3068\u304c\u7406\u7531\u304b\u3082\u3057\u308c\u307e\u305b\u3093",
      howMixed:"\u76f4\u63a5\u7684\u3067\u3082\u6ce8\u610f\u6df1\u304f\u3067\u3082\u3001\u3069\u3061\u3089\u3082\u3042\u308a\u3067\u3059\u3002\u81ea\u7136\u306b\u611f\u3058\u308b\u65b9\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044",
      howGood:"\u4eca\u306f\u76f4\u63a5\u7684\u3067\u81ea\u4fe1\u3092\u6301\u3063\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u304c\u4e00\u756a\u3067\u3059",
      howBad:"\u4eca\u306f\u3086\u3063\u304f\u308a\u3068\u6ce8\u610f\u6df1\u304f\u9032\u3081\u308b\u65b9\u304c\u826f\u3044\u3067\u3057\u3087\u3046",
      unclearBottom:"\u3069\u3061\u3089\u3068\u3082\u8a00\u3048\u307e\u305b\u3093\u3002\u76f4\u611f\u3092\u4fe1\u3058\u3066\u304f\u3060\u3055\u3044",
    } : null;

    if(qType === 'when'){
      headline = mixed ? (L?L.unclear:'UNCLEAR') : (favorable ? (L?L.soon:'SOON') : (L?L.notYet:'NOT YET'));
      advice = mixed ? (L?L.whenMixed:"the timing isn't clearly signaled - reassess in a few days")
        : (favorable ? (L?L.whenGood:"sooner rather than later looks right") : (L?L.whenBad:"it's better to let more time pass first"));
      if(!favorable || mixed) stamp.classList.add('mixed');
    } else if(qType === 'why'){
      headline = L ? L.reflect : 'REFLECT';
      advice = mixed ? (L?L.whyMixed:"the reading is mixed - the reason may be more than one thing")
        : (favorable ? (L?L.whyGood:"the reason likely has to do with something currently working in your favor")
                     : (L?L.whyBad:"the reason may be that something's out of balance or being rushed"));
      stamp.classList.add('mixed');
    } else if(qType === 'how'){
      headline = mixed ? (L?L.eitherWay:'EITHER WAY') : (favorable ? (L?L.directly:'DIRECTLY') : (L?L.carefully:'CAREFULLY'));
      advice = mixed ? (L?L.howMixed:"either a direct or careful approach could work - go with what feels natural")
        : (favorable ? (L?L.howGood:"a direct, confident approach works best right now") : (L?L.howBad:"a slower, more careful approach serves you better right now"));
      if(!favorable || mixed) stamp.classList.add('mixed');
    } else {
      if(favorable){ headline = L?L.yes:'YES'; advice = theme.good; }
      else if(!mixed){ headline = L?L.no:'NO'; advice = theme.bad; stamp.classList.add('mixed'); }
      else { headline = L?L.unclear:'UNCLEAR'; advice = L?L.unclearBottom:"the signs don't strongly favor either way - trust your gut"; stamp.classList.add('mixed'); }
    }

    stamp.textContent = headline;
    bottomLine.innerHTML = '<b>' + t.bottomLinePrefix + '</b> ' + advice + (currentLang === 'ja' ? '' : '.');
  } else {
    stamp.textContent = t.stampReadOnly;
    bottomLine.innerHTML = t.noQuestionBottom;
  }
}

function cast(){
  const que = parseInt(document.getElementById('que').value, 10);
  const hao = parseInt(document.getElementById('hao').value, 10);
  const question = document.getElementById('question').value.trim();
  const btn = document.getElementById('castBtn');
  const loading = document.getElementById('loading');
  const result = document.getElementById('result');

  if(!que || que < 1 || que > 64 || !hao || hao < 1 || hao > 6){
    alert(UI[currentLang].invalidAlert);
    return;
  }

  btn.disabled = true;
  result.style.display = 'none';
  loading.style.display = 'block';

  setTimeout(() => {
    lastReading = computeReading(que, hao, question);
    renderResult(lastReading);
    loading.style.display = 'none';
    result.style.display = 'block';
    btn.disabled = false;
  }, 700);
}

applyLanguage();
</script>
